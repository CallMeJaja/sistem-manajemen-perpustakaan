@startuml
title Use Case Diagram — Member (Anggota)

skinparam defaultFontSize 12
skinparam packageFontSize 11
skinparam packageStyle rectangle
left to right direction

actor "Anggota\n(Member)" as Member

rectangle "GramediKu — Portal Anggota" {
  usecase "Memverifikasi Email" as UC1

  package "Katalog" {
    usecase "Melihat Katalog Buku" as UC2
    usecase "Mencari Buku" as UC3
    usecase "Melihat Detail Buku" as UC4
  }

  package "Peminjaman" {
    usecase "Melakukan Reservasi Buku" as UC5
    usecase "Membatalkan Reservasi" as UC6
  }

  package "Portal" {
    usecase "Melihat Dashboard Personal" as UC7
    usecase "Melihat Status Peminjaman" as UC8
    usecase "Melihat Riwayat Peminjaman" as UC9
    usecase "Mengubah Profil" as UC10
  }
}

Member --> UC1
Member --> UC2
Member --> UC5
Member --> UC7
Member --> UC8
Member --> UC9
Member --> UC10

UC3 ..> UC2 : <<extend>>
UC4 ..> UC2 : <<extend>>
UC5 ..> UC4 : <<extend>>
UC6 ..> UC5 : <<extend>>
UC5 ..> UC1 : <<include>>

@enduml
